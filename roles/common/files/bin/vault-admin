#!/usr/bin/env bash
#
# vault-admin -- Authenticate to Vault and run commands
#
# Tries three methods in order:
#   1. TPM2 + age identity (automated, no prompts)
#   2. Passphrase backup (manual, prompts for passphrase)
#   3. Plaintext fallback (first run only)
#
# Usage: vault-admin [vault command args...]
# Example: vault-admin status
#          vault-admin kv get secret/grub
#          vault-admin   (opens authenticated shell)

set -euo pipefail

# staff_u admins land in staff_t under plain "sudo", which SELinux blocks
# from reading /root/.vault-root-token* (admin_home_t) and /dev/tpmrm0.
# Transparently re-exec into sysadm_t (the correct admin domain) instead
# of failing with a confusing "permission denied" from age/systemd-creds.
# unconfined_u admins and root already have broad access and skip this.
_my_context=$(id -Z 2>/dev/null || true)
if [[ "${_my_context}" == *":staff_r:staff_t:"* ]]; then
	exec sudo -r sysadm_r -t sysadm_t "$0" "$@"
fi

# Source vault environment if available
# shellcheck source=/dev/null  # generated by the vault role, not present at lint time
[ -f /etc/profile.d/vault.sh ] && . /etc/profile.d/vault.sh
export VAULT_ADDR="${VAULT_ADDR:-https://127.0.0.1:8200}"
export VAULT_CACERT="${VAULT_CACERT:-/etc/vault.d/certs/root.crt}"

VAULT_TOKEN=""

# Method 1: TPM2 + age identity (automated, no prompts)
if [ -z "${VAULT_TOKEN}" ] &&
	[ -f /root/.vault-root-token.age ] &&
	[ -f /etc/credstore.encrypted/vault-age-identity.cred ]; then
	VAULT_TOKEN=$(systemd-creds decrypt --name=vault-age-identity \
		/etc/credstore.encrypted/vault-age-identity.cred - 2>/dev/null |
		age -d -i - /root/.vault-root-token.age 2>/dev/null) || true
fi

# Method 2: Passphrase backup (manual, prompts for passphrase)
if [ -z "${VAULT_TOKEN}" ] && [ -f /root/.vault-root-token.age.pass ]; then
	echo "TPM2 unavailable. Decrypting with passphrase..."
	VAULT_TOKEN=$(age -d /root/.vault-root-token.age.pass) || true
fi

# Method 3: Plaintext fallback (first run only)
if [ -z "${VAULT_TOKEN}" ] && [ -f /root/.vault-root-token ]; then
	VAULT_TOKEN=$(cat /root/.vault-root-token)
fi

if [ -z "${VAULT_TOKEN}" ]; then
	echo "ERROR: Cannot decrypt root token." >&2
	echo "Ensure TPM2 is available or use passphrase backup." >&2
	exit 1
fi
export VAULT_TOKEN

if [ $# -eq 0 ]; then
	echo "Vault authenticated. Token expires with session."
	exec bash
else
	exec vault "$@"
fi
