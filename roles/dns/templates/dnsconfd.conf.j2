{{ ansible_managed | default('Ansible managed') | comment }}
# dnsconfd configuration -- manages Unbound and resolv.conf
# See dnsconfd.conf(5) for all options

# DNSSEC validation -- match our unbound.conf setting
dnssec_enabled: yes

# Resolver listen address (0.0.0.0 when LAN DNS is enabled, loopback otherwise)
listen_address: "{{ '0.0.0.0' if dns_lan_enabled | default(false) | bool else '127.0.0.1' }}"

# resolv.conf options
resolver_options: "edns0 trust-ad"

# CA bundle for DoT upstream verification
certification_authority: "{{ __dns_tls_cert_bundle }}"

# Wired interfaces get priority over wireless
prioritize_wire: yes

# Logging -- to the journal. Note: syslog_log takes a destination STRING
# ("unix:/dev/log" or "udp:host:port"), not a boolean. The old
# `syslog_log: yes` crashed dnsconfd at start-up the moment this file was
# actually read (it never was before -- see KNOWN_ISSUES #38).
journal_log: yes

# ---------------------------------------------------------------------------
# Static upstream DoT servers -- from dns_dot_upstreams (roles/dns defaults).
# Every upstream applies threat filtering, so failover never weakens policy
# (KNOWN_ISSUES P15: Google removed). The same list feeds the firewalld
# dot-egress policy (P16), so the two cannot drift.
# ---------------------------------------------------------------------------
static_servers:
{% for upstream in dns_dot_upstreams %}
  # {{ upstream.comment | default(upstream.name) }}
  - address: "{{ upstream.address }}"
    protocol: "dns+tls"
    name: "{{ upstream.name }}"
    dnssec: true
{% endfor %}

# RPZ is configured in Unbound conf.d directly, not here (see ADR-0004)

