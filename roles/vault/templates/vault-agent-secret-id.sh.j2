#!/usr/bin/env bash
# {{ ansible_managed }}
# Decrypt age-encrypted AppRole secret_id for Vault Agent
# Mirrors the TPM2/age pattern used by vault-auto-unseal

SECRET_AGE="/root/vault-approle-secret.age"
AGENT_DIR="{{ vault_agent_run_dir }}"
DEST="${AGENT_DIR}/agent-secret-id"

[ -f "${SECRET_AGE}" ] || { echo "No encrypted secret_id found"; exit 0; }

# Determine identity file for age decryption
identity_file=""
cleanup_identity=false
{% if vault_use_tpm2 %}
if [ -n "${CREDENTIALS_DIRECTORY:-}" ] && \
   [ -f "${CREDENTIALS_DIRECTORY}/vault-age-identity" ]; then
  identity_file="${CREDENTIALS_DIRECTORY}/vault-age-identity"
elif [ -f "/etc/credstore.encrypted/vault-age-identity.cred" ]; then
  identity_file="{{ vault_run_dir }}/agent-identity.tmp"
  cleanup_identity=true
  systemd-creds decrypt --name=vault-age-identity \
    /etc/credstore.encrypted/vault-age-identity.cred "${identity_file}" 2>/dev/null || true
fi
{% endif %}
if [ -z "${identity_file}" ] && [ -f "{{ vault_age_identity_file }}" ]; then
  identity_file="{{ vault_age_identity_file }}"
fi
[ -n "${identity_file}" ] && [ -f "${identity_file}" ] || { echo "No identity file available"; exit 1; }

# Decrypt secret_id
age -d -i "${identity_file}" "${SECRET_AGE}" > "${DEST}" 2>/dev/null
chown {{ vault_user }}:{{ vault_group }} "${DEST}"
chmod 0400 "${DEST}"

# Cleanup transient identity
if [ "${cleanup_identity}" = "true" ] && [ -f "${identity_file}" ]; then
  shred -u "${identity_file}" 2>/dev/null || rm -f "${identity_file}"
fi
