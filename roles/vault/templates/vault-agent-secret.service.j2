# {{ ansible_managed }}
[Unit]
Description=Vault Agent AppRole secret_id provisioning
After=vault.service vault-unseal.service
Requires=vault.service
Before=vault-agent.service

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/local/bin/vault-agent-secret-id

{% if vault_use_tpm2 and vault_tpm2_credential_exists | default(false) %}
LoadCredentialEncrypted=vault-age-identity:/etc/credstore.encrypted/vault-age-identity.cred
{% endif %}

[Install]
WantedBy=vault-agent.service multi-user.target
