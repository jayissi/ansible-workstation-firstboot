# {{ ansible_managed }}
[Unit]
Description=Vault Agent AppRole secret_id provisioning
After=vault.service vault-unseal.service
Requires=vault.service
Before=vault-agent.service

[Service]
Type=oneshot
# RemainAfterExit is intentionally OMITTED (defaults to false).
# vault-agent.service's "remove_secret_id_file_after_reading = true"
# auto_auth config deletes the plaintext secret_id file after each
# successful authentication -- this oneshot's job is to refresh that
# file, not to run once ever. Confirmed via runtime testing: with
# RemainAfterExit=true, systemd marked this unit "active (exited)"
# permanently after the first boot, so a later `systemctl restart
# vault-agent` alone (e.g. from the "Restart vault-agent" Ansible
# handler) saw the Requires= dependency as already satisfied and
# never re-ran ExecStart, leaving vault-agent with no secret_id file
# and stuck in a permanent "no known secret ID" auth retry loop.
# Without RemainAfterExit, this unit returns to "inactive" after each
# run, so systemd's Requires=/Before= ordering re-triggers it fresh
# on every subsequent start of vault-agent.service, regardless of the
# restart trigger (Ansible, systemd Restart=on-failure, or manual).
# Safe to re-run indefinitely: the AppRole role has
# secret_id_num_uses=0 (unlimited) and secret_id_ttl=0 (never
# expires), confirmed via the live /v1/auth/approle/role/vault-agent
# API response.
ExecStart=/usr/local/bin/vault-agent-secret-id

{% if vault_use_tpm2 and vault_tpm2_credential_exists | default(false) %}
LoadCredentialEncrypted=vault-age-identity:/etc/credstore.encrypted/vault-age-identity.cred
{% endif %}

[Install]
WantedBy=vault-agent.service multi-user.target
