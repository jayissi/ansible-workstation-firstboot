# {{ ansible_managed }}
# HashiCorp Vault CE configuration

storage "raft" {
  path    = "{{ vault_data_dir }}"
  node_id = "{{ vault_raft_node_id }}"
}

listener "tcp" {
  address            = "127.0.0.1:8200"
  tls_cert_file      = "{{ vault_tls_cert_file }}"
  tls_key_file       = "{{ vault_tls_key_file }}"
  tls_client_ca_file = "{{ vault_tls_client_ca_file_effective }}"
  tls_disable        = "false"
  x_forwarded_for_authorized_addrs             = "127.0.0.1"
  x_forwarded_for_client_cert_header           = "X-Client-Cert"
  x_forwarded_for_client_cert_header_decoders  = "URL,DER"
}

# Dedicated proxy listener: Nginx connects here with a client certificate.
# Port 8200 remains for CLI/Agent/Ansible (optional client cert).
# Port 8201 is Raft cluster comms -- never expose to Nginx.
listener "tcp" {
  address                            = "127.0.0.1:{{ vault_proxy_listener_port }}"
  tls_cert_file                      = "{{ vault_tls_cert_file }}"
  tls_key_file                       = "{{ vault_tls_key_file }}"
  tls_client_ca_file                 = "{{ vault_tls_client_ca_file_effective }}"
  tls_require_and_verify_client_cert = true
  tls_disable                        = "false"
  x_forwarded_for_authorized_addrs             = "127.0.0.1"
  x_forwarded_for_client_cert_header           = "X-Client-Cert"
  x_forwarded_for_client_cert_header_decoders  = "URL,DER"
}

api_addr     = "{{ vault_api_addr }}"
cluster_addr = "{{ vault_cluster_addr }}"
ui           = {{ vault_ui | lower }}
disable_mlock = {{ vault_disable_mlock | lower }}
log_level    = "{{ vault_log_level }}"
