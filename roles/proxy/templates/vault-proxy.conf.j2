# {{ ansible_managed }}
# Nginx reverse proxy: https://{{ proxy_server_name }} -> Vault :8202 (backend mTLS)

server {
    listen {{ proxy_listen_address }}:{{ proxy_listen_port }} ssl;
    http2 on;
    server_name {{ proxy_server_name }};

    ssl_certificate        {{ proxy_tls_cert }};
    ssl_certificate_key    {{ proxy_tls_key }};
    ssl_protocols          {{ proxy_tls_protocols }};
    ssl_client_certificate {{ proxy_tls_client_ca }};
    ssl_verify_client      optional;
    ssl_verify_depth       3;
    ssl_crl              /etc/nginx/certs/client-ca.crl;

    include {{ __proxy_conf_d_dir }}/security-headers.inc;

    access_log /var/log/nginx/vault-mtls-access.log vault_mtls_json;

    limit_conn per_ip 20;

    proxy_connect_timeout 5s;
    proxy_send_timeout    10s;
    proxy_read_timeout    30s;
    send_timeout          10s;

    # CSP violation reports (KNOWN_ISSUES P29). Browsers POST a small JSON
    # report here (report-uri in security-headers.inc). nginx only reads a
    # request body when it proxies it, so the report is passed to a
    # loopback-only sink (csp-report-sink.conf) that returns 204, and the
    # body is logged as JSON. No add_header here: this location inherits
    # the server-level security headers.
    location = /csp-report {
        limit_except POST {
            deny all;
        }
        limit_req zone=vault_api burst=10 nodelay;
        client_max_body_size 64k;
        client_body_buffer_size 64k;
        access_log /var/log/nginx/csp-report.log csp_report;
        proxy_pass http://127.0.0.1:{{ proxy_csp_sink_port }}/;
        proxy_set_header X-Client-Cert "";
    }

    location /v1/auth/ {
        limit_req zone=vault_auth burst=10 nodelay;
        proxy_pass {{ proxy_backend_url }};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate {{ proxy_tls_ca }};
        proxy_ssl_certificate {{ proxy_tls_proxy_client_cert }};
        proxy_ssl_certificate_key {{ proxy_tls_proxy_client_key }};
        proxy_ssl_server_name on;
        proxy_ssl_name {{ proxy_server_name }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Client-Cert $ssl_client_escaped_cert;
    }

    location / {
        limit_req zone=vault_api burst=50 nodelay;
        proxy_pass {{ proxy_backend_url }};
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate {{ proxy_tls_ca }};
        proxy_ssl_certificate {{ proxy_tls_proxy_client_cert }};
        proxy_ssl_certificate_key {{ proxy_tls_proxy_client_key }};
        proxy_ssl_server_name on;
        proxy_ssl_name {{ proxy_server_name }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Client-Cert $ssl_client_escaped_cert;
    }
}
