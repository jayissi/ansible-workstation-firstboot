policy_module(usbguard-gdm, 1.0.0)

# Allow usbguard-daemon to probe two GDM/session-manager sockets
# during startup, mirroring the same upstream FD-enumeration
# behavior already observed and fixed for fapolicyd (see
# fapolicyd-gdm.te):
#   1. GDM's unix socket (xdm_var_run_t, sock_file write)
#   2. systemd-machined's varlink socket at
#      /run/systemd/userdb/io.systemd.Machine (systemd_machined_t
#      domain, unix_stream_socket connectto)

require {
    type usbguard_t;
    type xdm_var_run_t;
    type systemd_machined_t;
    class sock_file write;
    class unix_stream_socket connectto;
}

allow usbguard_t xdm_var_run_t:sock_file write;
allow usbguard_t systemd_machined_t:unix_stream_socket connectto;
