FROM registry.fedoraproject.org/fedora:44 AS base

RUN dnf install -y python3 python3-pip make ansible-core ShellCheck \
        gitleaks hadolint selint shfmt libatomic nodejs npm && \
    npm install -g markdownlint-cli2 markdown-table-formatter && \
    dnf clean all

WORKDIR /workspace

# Copy requirements files with distinct names to avoid basename collision
# (both collections/ and roles/ have requirements.yml)
COPY requirements-lint.txt ./
COPY .gitignore ./
COPY collections/requirements.yml ./collections-requirements.yml
COPY roles/requirements.yml ./roles-requirements.yml

RUN python3 -m venv .venv && \
    .venv/bin/python -m pip install --upgrade pip && \
    .venv/bin/python -m pip install -r requirements-lint.txt && \
    . .venv/bin/activate && \
    ansible-galaxy collection install -r collections-requirements.yml --force && \
    ansible-galaxy role install -r roles-requirements.yml --force -p roles/

COPY . .

ENV YAMLLINT_CONFIG_FILE=lint/.yamllint.yml

CMD ["bash", "-c", "\
  . .venv/bin/activate && \
  yamllint . && \
  ansible-lint && \
  ruff check . && \
  pyright && \
  pymarkdown --config lint/.pymarkdownlint.yml scan \
    README.md CONTRIBUTING.md SECURITY.md docs/CHANGELOG.md docs/*.md docs/decisions/*.md && \
  markdownlint-cli2 --config lint/.markdownlint-cli2.yaml && \
  markdown-table-formatter --check README.md CONTRIBUTING.md SECURITY.md docs/*.md && \
  linkbust README.md CONTRIBUTING.md SECURITY.md docs/CHANGELOG.md docs/*.md docs/decisions/*.md && \
  codespell --config pyproject.toml \
    inventory/ playbooks/ roles/common/ roles/dns/ roles/avahi/ roles/vault/ roles/proxy/ roles/verification/ \
    collections/ Makefile README.md CONTRIBUTING.md SECURITY.md docs/CHANGELOG.md pyproject.toml lint/ \
    ansible.cfg requirements-lint.txt requirements-rpm.txt .github/ && \
  bandit -c pyproject.toml -r roles/common/ roles/dns/ roles/avahi/ roles/vault/ roles/proxy/ roles/verification/ playbooks/ && \
  checkov --config-file lint/.checkov.yaml -d . && \
  detect-secrets scan --baseline lint/.secrets.baseline && \
  actionlint .github/workflows/*.yml && \
  shellcheck roles/common/files/bin/* roles/common/files/bashrc.d/* lint/lint-fedora-native.sh && \
  bash lint/lint-fedora-native.sh \
"]
