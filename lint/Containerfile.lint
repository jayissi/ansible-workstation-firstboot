# =============================================================================
# Lint toolchain image -- Ansible Workstation Firstboot
# =============================================================================
# Provides all 18 lint tools in a single Podman image.  The entry point
# is lint/lint-all.sh, which handles auto-fix and verification.
#
# Usage:
#   podman build -t ansible-workstation-lint -f lint/Containerfile.lint .
#   podman run --rm -v "$PWD":/workspace:z ansible-workstation-lint
# =============================================================================
FROM registry.fedoraproject.org/fedora:44 AS base

LABEL maintainer="jayissi" \
      description="Lint toolchain for ansible-workstation-firstboot"

# -- System packages (dnf) + Node tools (npm) --------------------------------
RUN dnf install -y --setopt=install_weak_deps=False \
        python3 python3-pip ansible-core ShellCheck \
        gitleaks hadolint selint shfmt libatomic nodejs npm && \
    npm install -g markdownlint-cli2 markdown-table-formatter && \
    dnf clean all && \
    rm -rf /var/cache/dnf

WORKDIR /workspace

# -- Dependency manifests (copied early for layer caching) --------------------
COPY requirements-lint.txt ./
COPY .gitignore ./
COPY collections/requirements.yml ./collections-requirements.yml
COPY roles/requirements.yml ./roles-requirements.yml

# -- Lint venv at /opt/.venv (outside /workspace, immune to bind-mounts) ------
RUN python3 -m venv /opt/.venv && \
    /opt/.venv/bin/python -m pip install --no-cache-dir --upgrade pip && \
    /opt/.venv/bin/python -m pip install --no-cache-dir -r requirements-lint.txt && \
    . /opt/.venv/bin/activate && \
    ansible-galaxy collection install -r collections-requirements.yml --force && \
    ansible-galaxy role install -r roles-requirements.yml --force -p roles/

# -- Project source (invalidates cache on any file change) --------------------
COPY . .

ENV YAMLLINT_CONFIG_FILE=lint/.yamllint.yml

CMD ["bash", "lint/lint-all.sh"]
